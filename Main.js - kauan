// ===================================
// 1. ESTOQUE DE ALIMENTOS
// ===================================

// Alimentos armazenados em gramas
// Pães, ovos e bebidas embaladas em unidades
// Suco armazenado em mililitros

let estoque = {
    arroz: 0,
    feijao: 0,
    frango: 0,
    carne: 0,
    macarrao: 0,
    legumes: 0,
    salada: 0,
    pao: 0,
    ovo: 0,

    // Bebidas
    suco: 0,
    agua: 0,
    refrigerante: 0
};


// ===================================
// 2. UNIDADES DAS DOAÇÕES
// ===================================

const unidades = {
    arroz: "kg",
    feijao: "kg",
    frango: "kg",
    carne: "kg",
    macarrao: "kg",
    legumes: "kg",
    salada: "kg",

    pao: "un",
    ovo: "un",

    suco: "L",
    agua: "un",
    refrigerante: "un"
};


// ===================================
// 3. MODELOS DE REFEIÇÕES
// ===================================

// Quantidades em gramas ou unidades

const receitas = {

    tradicionalFrango: {
        arroz: 200,
        feijao: 100,
        frango: 150,
        salada: 70
    },

    tradicionalCarne: {
        arroz: 200,
        feijao: 100,
        carne: 150,
        salada: 70
    },

    macarronada: {
        macarrao: 250,
        carne: 120,
        legumes: 100
    },

    vegetariana: {
        arroz: 200,
        feijao: 120,
        legumes: 180
    },

    lanche: {
        pao: 2,
        ovo: 1,
        salada: 50
    }
};


// ===================================
// 4. RECEBER DOAÇÕES
// ===================================

function receberDoacao(alimento, quantidade) {

    if (!(alimento in estoque)) {
        console.log("Alimento não cadastrado!");
        return;
    }

    if (!Number.isFinite(quantidade) || quantidade <= 0) {
        console.log("Quantidade inválida!");
        return;
    }

    let unidade = unidades[alimento];

    if (unidade === "un") {

        if (!Number.isInteger(quantidade)) {
            console.log("Informe uma quantidade inteira!");
            return;
        }

        estoque[alimento] += quantidade;

    } else {

        // Converte kg para g ou litros para ml
        estoque[alimento] += Math.round(quantidade * 1000);
    }

    console.log(`Recebido: ${quantidade} ${unidade} de ${alimento}`);
}


// ===================================
// 5. CALCULAR MARMITAS
// ===================================

function calcularMarmitas(modelo) {

    let receita = receitas[modelo];

    if (!receita) {
        console.log("Modelo não encontrado!");
        return 0;
    }

    let total = Infinity;

    for (let alimento in receita) {

        let quantidadeEstoque = estoque[alimento];
        let quantidadeNecessaria = receita[alimento];

        let porcoes = Math.floor(
            quantidadeEstoque / quantidadeNecessaria
        );

        total = Math.min(total, porcoes);
    }

    return total;
}


// ===================================
// 6. PRODUZIR MARMITAS
// ===================================

function produzirMarmitas(modelo, quantidade) {

    if (!receitas[modelo]) {
        console.log("Modelo não encontrado!");
        return;
    }

    if (!Number.isInteger(quantidade) || quantidade <= 0) {
        console.log("Quantidade inválida!");
        return;
    }

    let disponiveis = calcularMarmitas(modelo);

    if (quantidade > disponiveis) {

        console.log("Alimentos insuficientes!");
        return;

    } else {

        let receita = receitas[modelo];

        for (let alimento in receita) {

            let consumo = receita[alimento] * quantidade;

            estoque[alimento] -= consumo;
        }

        console.log(
            `${quantidade} refeições do modelo ${modelo} produzidas!`
        );
    }
}


// ===================================
// 7. MOSTRAR ESTOQUE
// ===================================

function mostrarEstoque() {

    console.log("\n===== ESTOQUE ATUAL =====");

    for (let alimento in estoque) {

        let unidade = unidades[alimento];
        let quantidade = estoque[alimento];

        if (unidade === "kg" || unidade === "L") {
            quantidade = (quantidade / 1000).toFixed(2);
        }

        console.log(`${alimento}: ${quantidade} ${unidade}`);
    }
}


// ===================================
// 8. MOSTRAR REFEIÇÕES DISPONÍVEIS
// ===================================

function mostrarMarmitas() {

    console.log("\n===== REFEIÇÕES DISPONÍVEIS =====");

    for (let modelo in receitas) {

        let quantidade = calcularMarmitas(modelo);

        console.log(`${modelo}: ${quantidade}`);
    }

    // Os modelos compartilham alimentos.
    // Não some essas quantidades.
}


// ===================================
// 9. CALCULAR BEBIDAS
// ===================================

function mostrarBebidas() {

    console.log("\n===== BEBIDAS DISPONÍVEIS =====");

    // Cada copo de suco tem 200 ml
    let coposSuco = Math.floor(estoque.suco / 200);

    console.log(`Copos de suco (200 ml): ${coposSuco}`);

    console.log(`Águas: ${estoque.agua} unidades`);

    console.log(`Refrigerantes: ${estoque.refrigerante} unidades`);
}


// ===================================
// 10. TESTANDO O SISTEMA
// ===================================

// Doações de alimentos
receberDoacao("arroz", 10);
receberDoacao("feijao", 8);
receberDoacao("frango", 6);
receberDoacao("carne", 5);
receberDoacao("macarrao", 10);
receberDoacao("legumes", 5);
receberDoacao("salada", 4);
receberDoacao("pao", 50);
receberDoacao("ovo", 30);

// Doações de bebidas
receberDoacao("suco", 10);
receberDoacao("agua", 30);
receberDoacao("refrigerante", 20);

// Mostrar estoque
mostrarEstoque();

// Verificar refeições disponíveis
mostrarMarmitas();

// Produzir 10 marmitas de frango
produzirMarmitas("tradicionalFrango", 10);

// Produzir 5 marmitas vegetarianas
produzirMarmitas("vegetariana", 5);

// Mostrar estoque restante
mostrarEstoque();

// Mostrar novas quantidades disponíveis
mostrarMarmitas();

// Consultar bebidas
mostrarBebidas();
